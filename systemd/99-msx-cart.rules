# FAT USB만 장치별 경로에 읽기전용으로 마운트한다 (파티션 없는 USB 포함).
# --bind-device: 해당 장치가 사라지면 그 장치의 마운트만 정리한다.
# 설치/업데이트 후 기존 팩을 분리했다 다시 연결한다.
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd*", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat", RUN+="/usr/bin/systemd-mount --no-block --collect --automount=no --bind-device --fsck=no -o ro,nosuid,nodev,noexec /dev/%k /media/iq2000/%k"
